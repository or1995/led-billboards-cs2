<?xml version="1.0" encoding="utf-8"?>
<!--
  dotnet publish LedScreens/LedScreens.csproj -p:PublishProfile=UpdatePublishedConfiguration
  Publish = first upload, NewVersion = upload a new build (needs ModId), Update = change the page only.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <PublishDir>bin\Release\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <ModPublisherCommand>Update</ModPublisherCommand>
  </PropertyGroup>
</Project>
